{
 "big": [
  {
   "id": "q:reality",
   "text": {
    "ja": "私たちが見ている世界は、世界そのものなのか。"
   }
  },
  {
   "id": "q:self",
   "text": {
    "ja": "「私」とは何か。どこまでが自分なのか。"
   }
  },
  {
   "id": "q:others",
   "text": {
    "ja": "人はなぜ、他者とともに生きるのか。"
   }
  },
  {
   "id": "q:body",
   "text": {
    "ja": "身体は、考えることや学ぶことに何をもたらすのか。"
   }
  },
  {
   "id": "q:enough",
   "text": {
    "ja": "どれだけあれば、足りるのか。"
   }
  },
  {
   "id": "q:uncertainty",
   "text": {
    "ja": "わからないことと、どう付き合うのか。"
   }
  },
  {
   "id": "q:growth",
   "text": {
    "ja": "人は、何によって育つのか。"
   }
  },
  {
   "id": "q:change",
   "text": {
    "ja": "変わり続ける世界を、どうとらえるのか。"
   }
  }
 ],
